# Demo web: no requiere AWS, Meta ni Supabase.
# Solo el valor exacto true activa mocks. No usar NEXT_PUBLIC_MOCK_MODE.
MOCK_MODE=true
# Opcional, solo servidor: firma cookies de demo de 6 h.
# Sin valor se usa una clave pública exclusiva de la demo.
# Puedes generar una clave con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOCK_SESSION_SECRET=

# Reservadas para otros roles. No necesarias para la demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-specific URL; falls back to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Real Infobip webhook: independent of the web demo's MOCK_MODE.
# Enable only after migrations and the provider's Basic authentication profile are configured.
INFOBIP_WEBHOOK_ENABLED=false
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_WHATSAPP_SENDER=
INFOBIP_WEBHOOK_USERNAME=
# At least 24 characters; configure the same username/password in Infobip.
INFOBIP_WEBHOOK_PASSWORD=
# At least 32 bytes; stable across instances and deploys while confirmations remain valid.
INFOBIP_ONBOARDING_SECRET=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
AWS_REGION=
AWS_BEDROCK_MODEL_ID=

# Private media use Supabase Storage: business-audio and business-images (migration 008).
# Server composition can enable the Supabase reader + OpenAI adapter explicitly.
# Audio is opt-in; verify inbound routing and actual download origins. Model: gpt-transcribe.
OPENAI_API_KEY=
WHATSAPP_AUDIO_ENABLED=false

# Receipt extraction/review only; classification does not approve an operation.
WHATSAPP_RECEIPTS_ENABLED=false
OPENAI_RECEIPT_MODEL=gpt-6.1-sol
# Explicit HTTPS CDN origins for Infobip media redirects, comma-separated. No credentials are forwarded.
# Leave empty until actual redirect origins for the account are verified.
INFOBIP_MEDIA_REDIRECT_ORIGINS=
