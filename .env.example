# Demo web: no requiere AWS, Meta ni Supabase.
# Solo el valor exacto true activa mocks. No usar NEXT_PUBLIC_MOCK_MODE.
MOCK_MODE=true
# Opcional, solo servidor: firma cookies de demo de 6 h.
# Sin valor se usa una clave pública exclusiva de la demo.
# Puedes generar una clave con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOCK_SESSION_SECRET=

# Reservadas para otros roles. No necesarias para la demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
AWS_REGION=
AWS_BEDROCK_MODEL_ID=
